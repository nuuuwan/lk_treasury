    ],
    "text": "\u0dc0\u0dc1\u0dc0\u0dba\u0db1\u0dca \u0dc3\u0dc4\u0dcf\u0dba \u0dbd\u0db6\u0db1 \u0dc0\u0db8\u0d9c\u0dcf\u0dc0\u0dc0\u0dcf\u0dca 25\u0d9a \u0dc3\u0db8\u0dd4\u0da0\u0dca\u0dd2\u0dad\u0dca \u0dc4\u0dbd \u0db8\u0dad\u0dca \u0dc3\u0dd6\u0dbb\u0dca\u0dba \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0da2\u0db1\u0db1 \u0db4\u0daf\u0dca\u0db0\u0dd2, \u0dc0\u0dca \u0d9a\u0dd4 \u0dcf \u0dc4\u0dcf \u0db8\u0db0\u200d \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0dab \u0dc0\u200d\u0dc0\u0dc3\u0dcf\u0dba\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0dc0\u0dda \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0db6\u0dd2\u0dbd\u0dca\u0db4\u0dad\u0dca \u0db6 \u0d85\u0dc0\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dba\u0dcf\u0daf\u0dcf \u0d9c\u0db1\u0dd4 \u0d87\u0dad\u0dca. \u0dc0\u0db8\u0db8 \u0db4\u0daf\u0dca\u0db0\u0dd2 \u0db1\u0dc0\u0dd3\u0db1\u0dad\u0dca\u0db8 \u0db4\u0dcf\u0dbd\u0db1 \u0dad\u0dca\u0dcf\u0d9a\u0dca\u0dc2\u0dab\u0dc0\u0dba\u0db1\u0dca \u0dc3\u0db8\u0db1\u0dca\u0dc0\u0dd2\u0dad\u0dca \u0dc0\u0db1 \u0d85\u0dad\u0dca , \u0db4\u0dc0\u0dd2\u0db1 \u0da2\u0dcf\u0dbd \u0dc3\u0dd3\u0db8\u0dcf\u0d9a\u0dcf\u0dbb\u0dd3 \u0dad\u0dca\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0db1\u0dca\u0da7 \u0d85\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dc0 \u0d92\u0dc0\u0dcf\u0dc0\u0dda \u0da2\u0db1\u0db1\u0dba \u0da2\u0dcf\u0dd2\u0d9a \u0db4\u0daf\u0dca\u0db0\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0d9a\u0dbb\u0dd4\u0da7 \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a \u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc4 \u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0dbd \u0dc0\u0db6\u0db1\u0dd4 \u0d87\u0dad\u0dca.",
